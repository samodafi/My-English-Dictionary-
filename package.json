{
  "name": "lexi-dictionary",
  "version": "1.0.0",
  "description": "Offline English dictionary with downloadable data packs and accent audio",
  "main": "main.js",
  "author": "Lexi",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:icons": "capacitor-assets generate --android"
  },
  "build": {
    "appId": "com.lexi.dictionary",
    "productName": "Lexi Dictionary",
    "files": [
      "main.js",
      "www/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}